{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lore.corpus.workbench/schemas/object-ref.schema.json",
  "title": "Object Reference Schema (Phase-1 Minimal)",
  "type": "object",
  "required": ["id", "type", "target_id", "status"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "object-ref" },
    "target_id": { "type": "string" },
    "status": { "type": "string" },
    "alias": { "type": "string" },
    "target_type": { "type": "string" },
    "resolved": { "type": "boolean" }
  },
  "additionalProperties": true
}
