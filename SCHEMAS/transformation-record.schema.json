{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lore.corpus.workbench/schemas/transformation-record.schema.json",
  "title": "Transformation Record Schema",
  "type": "object",
  "required": ["id", "type", "title", "status", "inputs", "transformation"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "transformation-record" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "transformation": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
