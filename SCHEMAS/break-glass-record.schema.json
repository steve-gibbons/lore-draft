{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lore.corpus.workbench/schemas/break-glass-record.schema.json",
  "title": "Break-Glass Record Schema",
  "type": "object",
  "required": ["id", "type", "title", "status", "actor", "reason", "scope"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "break-glass-record" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "actor": { "type": "string" },
    "reason": { "type": "string" },
    "scope": { "type": "string" },
    "expires_at": { "type": "string" },
    "revocation_trail": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
